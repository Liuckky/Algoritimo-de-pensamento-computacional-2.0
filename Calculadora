/* Calculadora de Matrizes - compilar: gcc calculadora.c -o calculadora -lm */
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <math.h>

#define N 10 /* maximo de matrizes e de linhas/colunas */

typedef struct { int l, c; double d[N][N]; } Mat;
enum { SOMA = 1, SUB, MULT, DIV };

/* ---------- Leitura ---------- */
static int lerInt(const char *msg, int min, int max) {
    char b[64], *f; long v;
    for (;;) {
        printf("%s", msg);
        if (!fgets(b, sizeof b, stdin)) exit(0);
        v = strtol(b, &f, 10);
        if (f != b && f[strspn(f, " \t\r\n")] == 0 && v >= min && v <= max) return (int)v;
        printf("Valor invalido (%d a %d).\n", min, max);
    }
}

static double lerReal(const char *msg) {
    char b[64], *f; double v;
    for (;;) {
        printf("%s", msg);
        if (!fgets(b, sizeof b, stdin)) exit(0);
        for (char *p = b; *p; p++) if (*p == ',') *p = '.'; /* aceita 2,5 */
        v = strtod(b, &f);
        if (f != b && f[strspn(f, " \t\r\n")] == 0 && isfinite(v)) return v;
        printf("Valor invalido.\n");
    }
}

static void lerMat(Mat *m, int idx) {
    char msg[40];
    printf("\n--- Matriz %d ---\n", idx);
    m->l = lerInt("Linhas (1 a 10): ", 1, N);
    m->c = lerInt("Colunas (1 a 10): ", 1, N);
    for (int i = 0; i < m->l; i++)
        for (int j = 0; j < m->c; j++) {
            snprintf(msg, sizeof msg, "Elemento [%d][%d]: ", i + 1, j + 1);
            m->d[i][j] = lerReal(msg);
        }
}

/* ---------- Exibicao ---------- */
static void exibir(const Mat *m) {
    for (int i = 0; i < m->l; i++) {
        printf("|");
        for (int j = 0; j < m->c; j++) printf(" %8.2f", fabs(m->d[i][j]) < 1e-9 ? 0.0 : m->d[i][j]);
        printf(" |\n");
    }
}

/* ---------- Validacao: devolve 1 se a operacao e possivel ---------- */
static int validar(int op, const Mat *a, const Mat *b) {
    if ((op == SOMA || op == SUB) && (a->l != b->l || a->c != b->c))
        printf("Erro: soma/subtracao exigem mesmas dimensoes (%dx%d e %dx%d).\n", a->l, a->c, b->l, b->c);
    else if (op == MULT && a->c != b->l)
        printf("Erro: colunas da 1a (%d) diferem das linhas da 2a (%d).\n", a->c, b->l);
    else if (op == DIV && b->l != b->c)
        printf("Erro: o divisor (%dx%d) nao e quadrado.\n", b->l, b->c);
    else if (op == DIV && a->c != b->l)
        printf("Erro: dimensoes incompativeis para divisao (%dx%d / %dx%d).\n", a->l, a->c, b->l, b->c);
    else return 1;
    return 0;
}

/* ---------- Operacoes ---------- */
static void multiplicar(const Mat *a, const Mat *b, Mat *r) {
    r->l = a->l; r->c = b->c;
    for (int i = 0; i < r->l; i++)
        for (int j = 0; j < r->c; j++) {
            r->d[i][j] = 0;
            for (int k = 0; k < a->c; k++) r->d[i][j] += a->d[i][k] * b->d[k][j];
        }
}

/* Inversa por Gauss-Jordan; devolve 0 se a matriz for singular. */
static int inverter(const Mat *m, Mat *inv) {
    Mat a = *m; int n = m->l;
    inv->l = inv->c = n;
    for (int i = 0; i < n; i++) for (int j = 0; j < n; j++) inv->d[i][j] = (i == j);
    for (int c = 0; c < n; c++) {
        int p = c;
        for (int i = c + 1; i < n; i++) if (fabs(a.d[i][c]) > fabs(a.d[p][c])) p = i;
        if (fabs(a.d[p][c]) < 1e-9) return 0;
        for (int j = 0; j < n; j++) {
            double t = a.d[c][j]; a.d[c][j] = a.d[p][j]; a.d[p][j] = t;
            t = inv->d[c][j]; inv->d[c][j] = inv->d[p][j]; inv->d[p][j] = t;
        }
        double piv = a.d[c][c];
        for (int j = 0; j < n; j++) { a.d[c][j] /= piv; inv->d[c][j] /= piv; }
        for (int i = 0; i < n; i++) if (i != c) {
            double f = a.d[i][c];
            for (int j = 0; j < n; j++) { a.d[i][j] -= f * a.d[c][j]; inv->d[i][j] -= f * inv->d[c][j]; }
        }
    }
    return 1;
}

static int operar(int op, const Mat *a, const Mat *b, Mat *r) {
    if (!validar(op, a, b)) return 0;
    if (op == SOMA || op == SUB) {
        *r = *a;
        for (int i = 0; i < a->l; i++)
            for (int j = 0; j < a->c; j++) r->d[i][j] += (op == SOMA ? 1 : -1) * b->d[i][j];
    } else if (op == MULT) {
        multiplicar(a, b, r);
    } else { /* A / B = A x B^-1 */
        Mat inv;
        if (!inverter(b, &inv)) { printf("Erro: o divisor e singular (nao possui inversa).\n"); return 0; }
        multiplicar(a, &inv, r);
    }
    return 1;
}

/* Aplica a operacao da esquerda para a direita, na ordem de cadastro. */
static void calcular(int op, const Mat *m, int n) {
    Mat acc = m[0], prox;
    for (int i = 1; i < n; i++) {
        if (!operar(op, &acc, &m[i], &prox)) { printf("(falha na etapa com a Matriz %d)\n", i + 1); return; }
        acc = prox;
    }
    printf("\nResultado (%dx%d):\n", acc.l, acc.c);
    exibir(&acc);
}

/* ---------- Programa ---------- */
int main(void) {
    Mat m[N]; int n, op;
    do {
        n = lerInt("Quantas matrizes deseja cadastrar (2 a 10)? ", 2, N);
        for (int i = 0; i < n; i++) lerMat(&m[i], i + 1);
        for (int i = 0; i < n; i++) { printf("\nMatriz %d:\n", i + 1); exibir(&m[i]); }
        do {
            printf("\n1-Adicao 2-Subtracao 3-Multiplicacao 4-Divisao 5-Novas matrizes 0-Sair\n");
            op = lerInt("Opcao: ", 0, 5);
            if (op >= SOMA && op <= DIV) calcular(op, m, n);
        } while (op != 0 && op != 5);
    } while (op == 5);
    return 0;
}
